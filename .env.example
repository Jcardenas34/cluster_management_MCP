# .env.example
SPARK_MASTER_HOST=your.master.ip
SPARK_WORKER_HOSTS=worker1.ip,worker2.ip,worker3.ip
SSH_USER=your_ssh_user
SSH_KEY_PATH=/path/to/your/private/key
PROMETHEUS_URL=http://your.prometheus.host:9090
CONDA_PATH=/path/to/miniconda3
SPARK_JOB_DIR=/path/to/your/spark/jobs
# Host running the MLflow server (bound to its 127.0.0.1:5000); the backend opens an
# SSH tunnel to it at startup. Defaults to SPARK_MASTER_HOST.
MLFLOW_SSH_HOST=your.mlflow.host
